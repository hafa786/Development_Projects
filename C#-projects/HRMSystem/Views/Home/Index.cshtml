@model List<Employee>
@{ViewData["Title"]="Dashboard";}
<div class="page-head"><div><h2>Good morning, Alex 👋</h2><p>Here’s what’s happening with your team today.</p></div><a asp-controller="Employees" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add employee</a></div>
<div class="row g-3 mb-4"><div class="col-md-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="bi bi-people"></i></span><div><small>Total employees</small><h3>@Model.Count</h3><em>↑ 8.2% this month</em></div></div></div><div class="col-md-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="bi bi-person-check"></i></span><div><small>Present today</small><h3>@(Model.Count-1)</h3><em>92% attendance</em></div></div></div><div class="col-md-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="bi bi-calendar2-minus"></i></span><div><small>On leave</small><h3>1</h3><em>2 requests pending</em></div></div></div><div class="col-md-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="bi bi-person-plus"></i></span><div><small>Open positions</small><h3>6</h3><em>24 candidates</em></div></div></div></div>
<div class="row g-3"><div class="col-xl-8"><div class="panel"><div class="panel-title"><div><h5>Employee overview</h5><small>Headcount over the last 6 months</small></div><span class="badge-soft">Last 6 months</span></div><div class="chart"><div style="height:45%"></div><div style="height:56%"></div><div style="height:52%"></div><div style="height:68%"></div><div style="height:76%"></div><div style="height:90%"></div></div><div class="months"><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span></div></div></div><div class="col-xl-4"><div class="panel"><div class="panel-title"><h5>Quick actions</h5></div><a class="quick" asp-controller="Employees" asp-action="Create"><i class="bi bi-person-plus"></i><span><b>Add employee</b><small>Create a new employee profile</small></span><i class="bi bi-chevron-right"></i></a><a class="quick" asp-controller="Leave"><i class="bi bi-calendar-check"></i><span><b>Review leave</b><small>Manage leave requests</small></span><i class="bi bi-chevron-right"></i></a><a class="quick" asp-controller="Payroll"><i class="bi bi-receipt"></i><span><b>Run payroll</b><small>Process monthly payroll</small></span><i class="bi bi-chevron-right"></i></a></div></div></div>
<div class="panel mt-3"><div class="panel-title"><div><h5>Recent employees</h5><small>Newest members of your organization</small></div><a asp-controller="Employees">View all</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Employee</th><th>Role</th><th>Department</th><th>Status</th><th>Joined</th></tr></thead><tbody>@foreach(var e in Model.OrderByDescending(x=>x.Joined)){<tr><td><div class="person"><span class="avatar">@e.Name.Substring(0,1)</span><div><b>@e.Name</b><small>@e.Email</small></div></div></td><td>@e.Role</td><td>@e.Department</td><td><span class="status @(e.Status=="Active"?"active":"leave")">@e.Status</span></td><td>@e.Joined.ToString("MMM dd, yyyy")</td></tr>}</tbody></table></div></div>

@model List<Employee>
@{ViewData["Title"]="Employees";}<div class="page-head"><div><h2>Employees</h2><p>Manage employee information and records.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add employee</a></div><div class="panel"><form class="searchbox mb-3"><i class="bi bi-search"></i><input name="q" placeholder="Search employees or departments..." /></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Employee</th><th>Role</th><th>Department</th><th>Status</th><th>Joined</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td><div class="person"><span class="avatar">@e.Name.Substring(0,1)</span><div><b>@e.Name</b><small>@e.Email</small></div></div></td><td>@e.Role</td><td>@e.Department</td><td><span class="status @(e.Status=="Active"?"active":"leave")">@e.Status</span></td><td>@e.Joined.ToString("dd MMM yyyy")</td><td><a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-light">Edit</a><form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline"><button class="btn btn-sm btn-light" onclick="return confirm('Delete this employee?')">Delete</button></form></td></tr>}</tbody></table></div></div>

<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - PeopleFlow HR</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link rel="stylesheet" href="~/css/site.css"></head><body>
<div class="sidebar"><div class="brand"><span class="logo">P</span><span>PeopleFlow</span></div><small>WORKSPACE</small>
<a asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Dashboard</a><a asp-controller="Employees" asp-action="Index"><i class="bi bi-people"></i> Employees</a><a asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i> Departments</a><a asp-controller="Attendance" asp-action="Index"><i class="bi bi-clock"></i> Attendance</a><a asp-controller="Leave" asp-action="Index"><i class="bi bi-calendar2-check"></i> Leave</a><a asp-controller="Payroll" asp-action="Index"><i class="bi bi-wallet2"></i> Payroll</a><a asp-controller="Recruitment" asp-action="Index"><i class="bi bi-person-plus"></i> Recruitment</a><div class="side-bottom"><a href="#"><i class="bi bi-gear"></i> Settings</a><div class="user"><span class="avatar">AS</span><div><b>Alex Smith</b><small>HR Administrator</small></div></div></div></div>
<main><header><div><button class="menu btn" onclick="document.body.classList.toggle('open')"><i class="bi bi-list"></i></button><span class="text-secondary">Human Resources Management</span></div><div><i class="bi bi-search me-4"></i><i class="bi bi-bell me-4"></i><span class="avatar">AS</span></div></header><div class="content">@RenderBody()</div></main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js"></script></body></html>
